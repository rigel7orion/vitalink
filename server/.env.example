# Set these in your shell or your host's dashboard.
PORT=8787
# Required in production. In development a random secret is generated once into data/.jwt-secret.
JWT_SECRET=
# The website origin allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:5173
# SQLite file location.
DATA_DIR=data
# Minutes east of UTC for the clinic's timezone (India = 330).
CLINIC_OFFSET_MIN=330
# Seed demo doctors + a demo patient into an EMPTY database. Defaults to true outside production.
SEED=true
# Optional: POST every alert notification to this URL (plug in SMS / WhatsApp / push there).
NOTIFY_WEBHOOK_URL=

# --- Billing (all optional; shown values are the defaults) ---
# Platform fee added to every booking, in PAISE (2500 = Rs 25.00).
PLATFORM_FEE_PAISE=2500
# GST percent on the platform fee / on the consultation fee.
PLATFORM_GST_PCT=18
CONSULT_GST_PCT=0
SELLER_NAME=VITALINK Health Pvt. Ltd.
SELLER_ADDRESS=Kolkata, West Bengal, India
# Printed on invoices when set.
SELLER_GSTIN=

# --- invoice delivery (all optional) ---
# Public https origin used in emailed / WhatsApp links (defaults to CORS_ORIGIN)
# PUBLIC_URL=https://your-site.example
# Email: run `npm --prefix server i nodemailer`, then e.g. a Gmail app password:
# SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM=VITALINK <you@gmail.com>
# POST every paid invoice here (n8n / Zapier / a WhatsApp bridge)
# INVOICE_WEBHOOK_URL=https://example.com/hook
# SHARE_TTL_HOURS=168
